enum EnumCourierDeliverySetting {
  AUTO_ACCEPT
  AUTO_REJECT
  MANUAL
  NONE
}

// Which push path a device uses. IOS rows arrive with row 59.
enum EnumDevicePlatform {
  ANDROID
  IOS
}

enum EnumCourierStatus {
  ONLINE
  OFFLINE
  LAST_CALL
}

// Why a rider's status changed (spec 0040).
enum EnumCourierStatusChangeCause {
  RIDER              // the rider's own switch (logout included)
  ADMIN              // an admin's edit of the rider
  CUT_OFF            // a credential change ended the rider's sessions (spec 0039)
  LAST_CALL_ACCEPTED // a Last Call rider accepted their last job and went Offline
  SYSTEM_START       // a seed, a dev script or the migration that began the record
  DEACTIVATED        // an admin deactivated the rider's account (spec 0051)
}

enum EnumDeliveryStatus {
  CREATED
  ASSIGNING_COURIER
  ACCEPTED
  DISPATCHED
  COURIER_ARRIVED_AT_PICKUP_LOCATION
  PICKED_UP
  ON_THE_WAY
  COURIER_ARRIVED_AT_DROPOFF_LOCATION
  DROPPED_OFF
  CANCELED
  FAILED
}

enum EnumDeliveryEventType {
  CREATED
  CONFIRMED
  ACCEPTED
  REJECTED
  DISPATCHED
  CANCELED
  FULFILLED
  ARRIVED_AT_DROPOFF_LOCATION
  DROPPED_OFF
  ARRIVED_AT_PICKUP_LOCATION
  PICKED_UP
  ON_THE_WAY
  FAILED
  REASSIGNED
  OFFERED
  OFFER_EXPIRED
  NO_COURIER_AVAILABLE
  // A delivery accepted but not picked up, sent back to waiting when dispatch stops (spec 0014).
  RETURNED_TO_WAITING
  // Spec 0015: recorded on a CANCELED delivery without a status change, never in STATE_MACHINE.
  COURIER_PAID_FOR_CANCELLATION
  FOOD_RETURNED
  FOOD_NOT_RETURNED
  // Spec 0016: a rider moved the drop off pin to where they stand. No status change, never in STATE_MACHINE.
  DROPOFF_POINT_CORRECTED
  // Spec 0020: a rider gave an accepted order back within the free window; it went back to matching.
  HANDED_BACK
  // Spec 0023: the restaurant moved the ready time, or marked the food ready. Recorded outside
  // STATE_MACHINE (the status does not change).
  READY_DELAYED
  FOOD_READY
  // A wrong or missing product reported, and resolved (spec 0032). No status change.
  PRODUCT_REPORTED
  PRODUCT_REPORT_RESOLVED
  // Spec 0033: a rider left a restaurant that kept them waiting, and the pay for that wait.
  WAIT_UNDISPATCHED
  COURIER_PAID_FOR_WAIT
  // Spec 0035: a rider asks dispatch to take them off an order, and the answer. Only
  // REMOVAL_APPROVED before pickup changes the status; the pay events are recorded beside it.
  REMOVAL_REQUESTED
  REMOVAL_WITHDRAWN
  REMOVAL_DECLINED
  REMOVAL_APPROVED
  COURIER_PAID_FOR_REMOVAL
  PARTNER_CHARGED_FOR_REMOVAL
  COURIER_PAID_FOR_RETURN_TRIP
  // Spec 0038: a rider asked a person to review a decision about this delivery, the answer, and
  // a pay correction the answer added. Saved with null statuses, never in STATE_MACHINE.
  REVIEW_REQUESTED
  REVIEW_ANSWERED
  COURIER_PAID_FOR_REVIEW
  // Spec 0043: no box size was sent so the default was used, the restaurant changed the size, and
  // an admin confirmed putting a rider past a full box. No status change, never in STATE_MACHINE.
  BOX_SIZE_ASSUMED
  BOX_SIZE_CHANGED
  BOX_OVER_CAPACITY_CONFIRMED
  // Spec 0047: a rider flagged an order that does not fit one box, an admin confirmed or refused the
  // split, the request closed another way (the rider left, or the delivery ended), and the restaurant
  // was charged a new leg's rider pay (or that charge voided). No status change, never in STATE_MACHINE.
  SPLIT_REQUESTED
  SPLIT_CONFIRMED
  SPLIT_REFUSED
  SPLIT_CLOSED
  PARTNER_CHARGED_FOR_SPLIT
  PARTNER_SPLIT_CHARGE_VOIDED
}

// Spec 0043: the size of an order's bag, picked by the restaurant. Co-op settings map each size to
// box units out of a rider's 100.
enum BoxSize {
  SMALL
  MEDIUM
  LARGE
}

// What a rider can report about a delivery from the app (decision 66.11). OTHER carries its
// detail in the note.
enum EnumDeliveryIssueReason {
  WRONG_ADDRESS
  NO_SIGNAL
  ORDER_HANDED
  // The restaurant marked the food ready and it was not (spec 0033, decision 23.16).
  FOOD_NOT_READY
  OTHER
}

// A rider's report about a delivery, read by the admin (decision 66.11). Several per delivery,
// each keeping its rider and time. Not a DeliveryEvent: it changes no status, pay or assignment.
model DeliveryIssue {
  id         String                  @id @default(cuid())
  deliveryId String
  delivery   Delivery                @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  courierId  String
  courier    Courier                 @relation(fields: [courierId], references: [id])
  reason     EnumDeliveryIssueReason
  note       String?                 @postgres.VarChar(500)
  createdAt  DateTime                @default(now())
  // Open until an admin marks it handled on the Dispatch board (spec 0034, AC-7). No way back.
  handledAt       DateTime?
  handledByUserId String?
  handledBy       User?             @relation(fields: [handledByUserId], references: [id], onDelete: SetNull)

  // The admin reads a delivery's reports in time order.
  @@index([deliveryId, createdAt])
}

// A wrong or missing product (spec 0032). Beside DeliveryIssue, which needs a rider and has no
// resolution. A report changes no pay and no status.
enum EnumProductReportKind {
  WRONG_ITEM
  MISSING_ITEM
}

enum EnumProductReportSource {
  COURIER
  PARTNER
  ADMIN
}

model ProductReport {
  id               String                  @id @default(cuid())
  deliveryId       String
  delivery         Delivery                @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  kind             EnumProductReportKind
  source           EnumProductReportSource
  reporterUserId   String
  itemName         String?                 @postgres.VarChar(120)
  note             String?                 @postgres.VarChar(500)
  resolvedAt       DateTime?
  resolvedByUserId String?
  resolution       String?                 @postgres.VarChar(500)
  createdAt        DateTime                @default(now())

  @@index([resolvedAt, createdAt])
  @@index([deliveryId, createdAt])
}

enum EnumCourierCompensationReason {
  REASSIGNMENT
  // Paid to the rider who held a delivery cancelled after they accepted it (spec 0015).
  CANCELLATION
  // Paid for waiting at a restaurant past its promised time (spec 0033).
  WAITING
  // Paid for being taken off a delivery before pickup, at the rider's request (spec 0035).
  REMOVAL
  // Paid for bringing the food back to the restaurant after a cancellation (spec 0035).
  RETURN_TRIP
  // A pay correction an admin added when answering a review request (spec 0038). Only adds.
  REVIEW
}

// Who cancelled a delivery (spec 0015). The partner says RESTAURANT or CUSTOMER; an admin may say COOP.
enum EnumCancelledBy {
  RESTAURANT
  CUSTOMER
  COOP
}

// What happened to food picked up before a cancellation, as the rider recorded it (spec 0015).
enum EnumFoodOutcome {
  RETURNED
  NOT_RETURNED
}

enum EnumPartnerChargeReason {
  CANCELLATION
  WAITING
  REMOVAL
  // Spec 0047: a new leg's full rider pay, made when an admin split an order that did not fit one box.
  SPLIT_LEG
}

// Spec 0047: a split request's life. OPEN until an admin confirms or refuses it, the rider leaves after
// the limit (LEFT), or the delivery ends or the rider is taken off another way (VOID).
enum EnumSplitRequestStatus {
  OPEN
  CONFIRMED
  REFUSED
  LEFT
  VOID
}

// Spec 0047: where a quote came from. A SPLIT quote is a copy made for a new leg: same distance and
// rider pay, customer price 0, so nothing is billed to the customer twice.
enum EnumQuoteSource {
  PARTNER
  SPLIT
}

// Spec 0047 (row 11): a rider at the restaurant flags an order that does not fit one box and proposes
// the legs; an admin confirms (possibly changed) or refuses. The one human exception queue.
model SplitRequest {
  id             String                 @id @default(cuid())
  deliveryId     String
  delivery       Delivery               @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  courierId      String
  courier        Courier                @relation(fields: [courierId], references: [id])
  // [{ boxSize }] per leg, the rider's proposal and the legs the admin confirmed.
  proposedLegs   Json
  finalLegs      Json?
  status         EnumSplitRequestStatus @default(OPEN)
  // The delivery id while OPEN, null otherwise: one open request per delivery (removal requests' pattern).
  openFor        String?                @unique
  createdAt      DateTime               @default(now())
  answeredAt     DateTime?
  answeredByUserId String?
  answeredBy     User?                  @relation(fields: [answeredByUserId], references: [id], onDelete: SetNull)
  // The admin's sentence with a refusal, shown to the rider. Never logged.
  adminNote      String?                @postgres.VarChar(300)
  // Set in the write that closes the request when its wait earns pay under the settings in force then
  // (spec 0033's waitPayOwedAt pattern); cleared once the award, its event and any charge exist. The
  // minute sweep retries a stamped request for 24 h (row 11 review).
  waitOwedAt     DateTime?

  @@index([status, createdAt])
  @@index([deliveryId, createdAt])
  @@index([waitOwedAt])
}

// Spec 0035: the co-op's list of reasons a rider can give for asking off an order. Whether each
// one pays the rider or bills the restaurant is set by representatives in admin (value 2).
model RemovalReason {
  id                  String    @id @default(cuid())
  label               String    @postgres.VarChar(60)
  paidToRider         Boolean   @default(true)
  chargedToRestaurant Boolean   @default(false)
  // Whether the rider must write a note with this reason.
  needsNote           Boolean   @default(false)
  position            Int
  // Set when an admin removes the reason; a request keeps its own copy, so old requests never change.
  removedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  requests DeliveryRemovalRequest[]
}

enum EnumRemovalRequestStatus {
  OPEN
  APPROVED
  DECLINED
  WITHDRAWN
  CLOSED
}

// Spec 0035: one rider's request to come off one delivery. A row beside the delivery: its status
// moves only when someone decides, and the rider keeps working the order until then.
model DeliveryRemovalRequest {
  id                  String                   @id @default(cuid())
  deliveryId          String
  delivery            Delivery                 @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  courierId           String
  courier             Courier                  @relation(fields: [courierId], references: [id])
  reasonId            String
  reason              RemovalReason            @relation(fields: [reasonId], references: [id])
  // Copied from the reason when the rider sends it, so editing the reason never changes this request.
  label               String                   @postgres.VarChar(60)
  paidToRider         Boolean
  chargedToRestaurant Boolean
  // The rider's own words: never in a log, a push to anyone else, or an event message.
  note                String?                  @postgres.VarChar(500)
  status              EnumRemovalRequestStatus @default(OPEN)
  // The delivery id while OPEN, null otherwise: one open request per delivery (the `cancellationOf` pattern).
  openFor             String?                  @unique
  createdAt           DateTime                 @default(now())
  decidedAt           DateTime?
  decidedByUserId     String?
  decidedBy           User?                    @relation(fields: [decidedByUserId], references: [id], onDelete: SetNull)
  // The sentence an admin wrote when declining.
  decisionNote        String?                  @postgres.VarChar(500)
  // Fixed at the approve, in cents, because a later rider's accept recalculates the delivery's pay.
  payAmount           Int?
  payPolicy           String?
  // Set at the approve: the food was already with the rider, so the order was cancelled.
  afterPickup         Boolean                  @default(false)
  // Set once every piece of this approval is written (the pay, the charge, their events).
  settledAt           DateTime?

  @@index([status, createdAt])
  @@index([deliveryId, createdAt])
}

// What a restaurant owes the co-op, recorded now and invoiced by the payments rows later
// (spec 0015: a restaurant's own cancellation after a rider accepted, for the delivery's price).
model PartnerCharge {
  id           String                  @id @default(cuid())
  partnerId    String
  partner      Partner                 @relation(fields: [partnerId], references: [id])
  // Spec 0015's cancellation and spec 0033's waits can both charge a delivery, so each has its own
  // once only key: the delivery id on a CANCELLATION row, the wait on a WAITING row.
  deliveryId   String
  cancellationOf String?                 @unique
  waitOf       String?                 @unique
  // The request's id on a REMOVAL row (spec 0035): one approved removal bills once.
  removalOf    String?                 @unique
  // Spec 0047: the new leg's delivery id on a SPLIT_LEG row (one leg bills once), and the split request's
  // id on a WAITING row for the wait while dispatch split the order (one split wait bills once).
  splitLegOf   String?                 @unique
  splitWaitOf  String?                 @unique
  delivery     Delivery                @relation(fields: [deliveryId], references: [id])
  amount       Int // cents
  currencyCode String                  @postgres.VarChar(255)
  reason       EnumPartnerChargeReason
  createdAt    DateTime                @default(now())
  // null until a payments row invoices it.
  invoicedAt   DateTime?
  // The open bill an admin put this charge in (spec 0036); null = not billed yet. Cleared only
  // when that bill is undone. The payments rows must treat a charge with a billId as billed.
  billId       String?
  bill         PartnerBill?            @relation(fields: [billId], references: [id], onDelete: Restrict)
  // On a WAITING row: the paid minutes, copied from the rider's award (spec 0036). Null otherwise,
  // and on an old row whose award message could not be read.
  waitMinutes  Int?
  // Every bill that ever covered this charge, undone ones included.
  billLines    PartnerBillLine[]

  @@index([partnerId, createdAt])
  @@index([billId])
}

// One bill of a restaurant's charges for one month, made by hand by an admin (spec 0036).
// Never deleted: a mistake is undone with a reason, and the lines stay.
model PartnerBill {
  id             String            @id @default(cuid())
  partnerId      String
  partner        Partner           @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  // The Athens calendar month every line belongs to, as YYYY-MM.
  month          String            @postgres.VarChar(7)
  // The invoice number the admin typed, if any.
  reference      String?           @postgres.VarChar(60)
  billedByUserId String?
  billedBy       User?             @relation(name: "partnerBillBilledBy", fields: [billedByUserId], references: [id], onDelete: SetNull)
  // A copy of the admin's email, else username, else id, so the record reads after a user delete.
  billedByLabel  String            @postgres.VarChar(255)
  createdAt      DateTime          @default(now())
  undoneAt       DateTime?
  undoneByUserId String?
  undoneBy       User?             @relation(name: "partnerBillUndoneBy", fields: [undoneByUserId], references: [id], onDelete: SetNull)
  undoneByLabel  String?           @postgres.VarChar(255)
  undoReason     String?           @postgres.VarChar(300)
  lines          PartnerBillLine[]
  // The charges this bill covers while it is open.
  charges        PartnerCharge[]

  @@index([partnerId, month])
}

// Which charges a bill covered when it was made. Never changed or deleted.
model PartnerBillLine {
  id       String        @id @default(cuid())
  billId   String
  bill     PartnerBill   @relation(fields: [billId], references: [id], onDelete: Restrict)
  chargeId String
  charge   PartnerCharge @relation(fields: [chargeId], references: [id], onDelete: Restrict)

  @@unique([billId, chargeId])
  @@index([chargeId])
}

// A payment owed to a courier that is NOT attached to a DROPPED_OFF event —
// e.g. the payout awarded to a rider dropped by an admin reassignment.
model CourierCompensation {
  id             String                        @id @default(cuid())
  amount         Int // cents
  currencyCode   String                        @postgres.VarChar(255)
  reason         EnumCourierCompensationReason
  policy         String // the policy key from the votable Config menu, e.g. FULL_COMPENSATION
  message        String?
  courierId      String
  courier        Courier                       @relation(fields: [courierId], references: [id])
  deliveryId     String
  delivery       Delivery                      @relation(fields: [deliveryId], references: [id])
  // The delivery id on a CANCELLATION row, null on every REASSIGNMENT row (spec 0015). Unique,
  // so one cancellation can never pay twice; Postgres allows any number of nulls under it.
  cancellationOf String?                       @unique
  // `<deliveryId>:<the event that ended the wait>` on a WAITING row, null otherwise (spec 0033):
  // one wait is paid once.
  waitOf         String?                       @unique
  // The request's id on a REMOVAL row (spec 0035): one approved removal pays once.
  removalOf      String?                       @unique
  // The delivery id on a RETURN_TRIP row (spec 0035): one trip back is paid once.
  returnOf       String?                       @unique
  // The review request's id on a REVIEW row (spec 0038): one review pays at most once.
  reviewOf       String?                       @unique
  // Spec 0047: the split request's id on the WAITING row for the wait while dispatch split the order.
  splitWaitOf    String?                       @unique
  // On a WAITING row: the minutes paid for (spec 0036). Null otherwise, and on an old row whose
  // message could not be read.
  waitMinutes    Int?
  createdAt      DateTime                      @default(now())

  // Earnings queries filter by courier + date range; DeliveryEvent's missing
  // createdAt index is a known mistake — do not repeat it here.
  @@index([courierId, createdAt])
}

