generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "postgresqlExtensions", "tracing"]
  engineType      = "library"
  output          = "./client"
}

datasource postgres {
  provider   = "postgresql"
  url        = env("DB_URL")
  extensions = [postgis()]
}

model User {
  id       String         @id @default(cuid())
  email    String?        @unique
  password String?
  role     EnumUserRole[]

  username String? @unique

  // A restaurant's API key, stored only as its SHA-256 hash (lower case hex), so a database copy
  // gives no working key. An admin makes it and sees it once (spec 0037). Null: no key.
  apiKeyHash      String?   @unique
  // When the current key was made, shown on the restaurant's admin page. Null exactly when
  // apiKeyHash is null; both are always written together (spec 0037).
  apiKeyCreatedAt DateTime?

  // When the password was last set by an admin (spec 0013). Every token issued before it is
  // refused, so a changed password signs the old phone out. Null: never changed.
  credentialsChangedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courier Courier?
  partner Partner?

  // SOS incidents this admin closed (spec 0022).
  sosIncidentsClosed SosIncident[]

  // Rider reports this admin marked handled (spec 0034).
  deliveryIssuesHandled DeliveryIssue[]

  // Removal requests this admin approved or declined (spec 0035).
  removalRequestsDecided DeliveryRemovalRequest[]

  // Split requests this admin answered (spec 0047).
  splitRequestsAnswered SplitRequest[]

  // Chat messages this user wrote, as dispatch, a rider or a restaurant (spec 0034, chat).
  chatMessagesSent ChatMessage[]

  // Bills of restaurant charges this admin made or undid (spec 0036).
  partnerBillsMade   PartnerBill[] @relation(name: "partnerBillBilledBy")
  partnerBillsUndone PartnerBill[] @relation(name: "partnerBillUndoneBy")

  // Review requests this admin answered (spec 0038).
  reviewRequestsAnswered ReviewRequest[]
  // Settings changes this admin saved (spec 0038).
  settingChanges         SettingChange[]
  // Rider status changes this admin made, directly or through a password change (spec 0040).
  courierStatusChanges   CourierStatusChange[]
  // Spec 0049: offline mid shift events this admin followed up.
  shiftEventsFollowedUp  ShiftBookingEvent[]   @relation("ShiftEventFollowedUpBy")
  // Spec 0050: the rider statements this admin downloaded.
  statementDownloads     StatementDownload[]
  // Spec 0052: complaints this admin filed, replies entered for a deactivated rider, decisions and
  // withdrawals. Never shown to a rider or a restaurant.
  complaintsFiled         Complaint[] @relation("complaintFiledByAdmin")
  complaintRepliesEntered Complaint[] @relation("complaintReplyEnteredBy")
  complaintsDecided       Complaint[] @relation("complaintDecidedBy")
  complaintsWithdrawn     Complaint[] @relation("complaintWithdrawnBy")
}

model Comment {
  id              String   @id @default(cuid())
  text            String?  @postgres.VarChar(255)
  likes           Int?     @default(0)
  likers          String[] @default([])
  commentableId   String
  commentableType String   @postgres.VarChar(255)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courierId String?
  couriers  Courier? @relation(fields: [courierId], references: [id], onDelete: Cascade)
}

model Courier {
  id              String                                @id @default(cuid())
  node_uri        String?                               @default("https://localhost") @postgres.VarChar(255)
  firstName       String                                @postgres.VarChar(255)
  lastName        String                                @postgres.VarChar(255)
  phoneNumber     String?                               @unique @postgres.VarChar(255)
  status          EnumCourierStatus                     @default(OFFLINE)
  deliverySetting EnumCourierDeliverySetting            @default(MANUAL)
  currentLocation Unsupported("geometry(Point, 4326)")?
  // When currentLocation was last written (spec 0034). Set in the same SQL statement as the
  // position, used only to leave stale riders off the dispatch map, and never sent to any client.
  currentLocationAt DateTime?
  rejectedOffers  String[]                              @default([])
  // Spec 0051 (row 108): a member who left. Set, the rider cannot sign in, refresh, connect or be
  // offered work; their deliveries, pay and records stay. The admin who did it, as a plain id.
  deactivatedAt         DateTime?
  deactivatedByUserId   String?
  // Spec 0051 (AC-4, cross check 12): the rider's emergency contact, kept on the server.
  emergencyContactName  String?                       @postgres.VarChar(120)
  emergencyContactPhone String?                       @postgres.VarChar(32)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: SetNull)

  stripeAccountId     String?                 @unique
  stripeAccountStatus EnumStripeAccountStatus @default(REJECTED)

  comments              Comment[]
  earnings              Earning[]
  deliveries            Delivery[]
  settings              CourierSetting?
  Payout                Payout[]
  Transfer              Transfer[]
  locationNotes         LocationNote[]
  locationNoteReactions LocationNoteReaction[]
  locationNoteFlags     LocationNoteFlag[]
  courierCompensations  CourierCompensation[]
  deliveryIssues        DeliveryIssue[]
  removalRequests       DeliveryRemovalRequest[]
  // Split requests this rider sent (spec 0047).
  splitRequests         SplitRequest[]
  // Events that name this rider (OFFERED, OFFER_EXPIRED), spec 0002. Read only on a
  // delivery's own timeline; never grouped by rider (binding value 5).
  deliveryEvents        DeliveryEvent[]
  // The phones this rider is logged in on, for offer push (spec 0003). One row per app install.
  devices               CourierDevice[]
  // This rider's SOS incidents (spec 0022). Never counted per rider anywhere (binding value 5).
  sosIncidents          SosIncident[]
  // Spec 0051 (AC-5): every account action on this rider, for the rider and admins to read.
  accountChanges        CourierAccountChange[]
  // Spec 0050 (AC-9): admin downloads of this rider's statements. Never counted per rider (value 5).
  statementDownloads    StatementDownload[]
  // This rider's shift bookings (spec 0027). Never counted per rider anywhere (binding value 5).
  shiftBookings         ShiftBooking[]
  // This rider's one conversation with dispatch (spec 0034, chat).
  chatThread            ChatThread?
  // This rider's review requests (spec 0038). Never counted per rider anywhere (binding value 5).
  reviewRequests        ReviewRequest[]
  // Spec 0052: complaints this rider filed, and complaints about this rider. Never counted, listed
  // for admins or scored per rider anywhere (AC-8, binding value 5).
  complaintsFiled       Complaint[]           @relation("complaintFiledByCourier")
  complaintsAbout       Complaint[]           @relation("complaintAboutCourier")
  // Every change of this rider's status (spec 0040), the source of their time worked. Never
  // counted across riders except in the co-op totals, which carry no rider id (binding value 5).
  statusChanges         CourierStatusChange[]
  // The admin search's folded names and phone (spec 0025). Written only by the database trigger
  // `courier_search_fold`; Prisma code never sets it, and no entity or DTO carries it.
  searchFold            String?

  // the index for that column
  @@index([currentLocation], name: "courier_location_idx", type: Gist)
}

// One app install's push token, so offers can reach a locked phone (spec 0003, row 58).
// Deliberately no updatedAt and nothing about deliveries, opens or answers: a row only says
// "this rider can be reached at this token" (binding value 5). A token that logs in as another
// rider moves to that rider; a token FCM reports dead is deleted.
model CourierDevice {
  id        String             @id @default(cuid())
  token     String             @unique
  platform  EnumDevicePlatform
  createdAt DateTime           @default(now())

  courierId String
  courier   Courier @relation(fields: [courierId], references: [id], onDelete: Cascade)

  @@index([courierId])
}

model Earning {
  id           String  @id @default(cuid())
  total        Int
  pending      Int
  received     Int
  payoutMethod String? @postgres.VarChar(255)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courierId String?
  couriers  Courier? @relation(fields: [courierId], references: [id], onDelete: Cascade)
}

model Location {
  id               String          @id @default(cuid())
  addressLine1     String?         @postgres.VarChar(255)
  addressLine2     String?         @postgres.VarChar(255)
  city             String?         @postgres.VarChar(255)
  state            String?         @postgres.VarChar(255)
  street           String?         @postgres.VarChar(255)
  zipCode          String?         @postgres.VarChar(255)
  countryCode      EnumCountryCode @default(US)
  stateCode        String?         @postgres.VarChar(255)
  houseNumber      String?         @postgres.VarChar(255)
  longitude        Float
  latitude         Float
  formattedAddress String?         @postgres.VarChar(255)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locationNotes LocationNote[]

  pickupDelivery  Delivery[] @relation(name: "pickupDelivery")
  dropoffDelivery Delivery[] @relation(name: "dropoffDelivery")

  pickupDeliveryQuotes  DeliveryQuote[] @relation(name: "pickupDeliveryQuotes")
  dropoffDeliveryQuotes DeliveryQuote[] @relation(name: "dropoffDeliveryQuotes")

  partnerPickups Partner[] @relation(name: "partnerPickupLocation")
}

model Partner {
  id          String  @id @default(cuid())
  name        String  @postgres.VarChar(255)
  logo        String? @postgres.VarChar(255)
  phoneNumber String? @postgres.VarChar(255)
  webhookUrl  String? @postgres.VarChar(255)
  // How long this restaurant usually takes to prepare an order, in whole minutes (0 to 90). A new
  // order's ready time starts from it when the restaurant gives none (spec 0023). Set in admin.
  usualPrepMinutes Int @default(15)
  // Spec 0029. Busy mode: minutes added to every new order's ready time; null is off.
  busyExtraMinutes Int?
  // Ordering paused until this moment; in force only while it is later than now.
  pausedUntil DateTime?
  // An admin disabled this restaurant, with this reason.
  disabledAt     DateTime?
  disabledReason String?   @postgres.VarChar(200)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries     Delivery[]
  deliveryQuotes DeliveryQuote[]
  savedCustomers SavedCustomer[]
  charges        PartnerCharge[]
  // Charges an admin billed by hand (spec 0036).
  bills          PartnerBill[]
  availabilityChanges PartnerAvailabilityChange[]
  // This restaurant's one conversation with dispatch (spec 0034, chat).
  chatThread     ChatThread?
  // Spec 0052: complaints this restaurant filed about a rider.
  complaintsFiled Complaint[]

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  pickupLocationId String?
  pickupLocation   Location? @relation(name: "partnerPickupLocation", fields: [pickupLocationId], references: [id], onDelete: SetNull)
}

enum EnumPartnerAvailabilityAction {
  BUSY_ON
  BUSY_OFF
  PAUSED
  RESUMED
  DISABLED
  ENABLED
}

// Spec 0029: who changed a restaurant's availability and when. Written in the transaction of the
// change itself; not a DeliveryEvent, since a restaurant's availability is not one delivery.
model PartnerAvailabilityChange {
  id          String                        @id @default(cuid())
  partnerId   String
  partner     Partner                       @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  action      EnumPartnerAvailabilityAction
  actorRole   EnumUserRole
  actorUserId String
  extraMinutes Int?
  pausedUntil  DateTime?
  reason       String?                      @postgres.VarChar(200)
  createdAt    DateTime                     @default(now())

  @@index([partnerId, createdAt])
}

// A restaurant's regular customer, kept so the next order takes a few taps (spec 0005). Personal
// data: only that restaurant and the co-op's admins see it, a daily job deletes it once unused for
// savedCustomerRetentionMonths, and a delivery never links here (it keeps its own copy).
model SavedCustomer {
  id               String   @id @default(cuid())
  name             String   @postgres.VarChar(255)
  // Always stored normalised (E.164, e.g. +306912345678), so one phone is one customer.
  phone            String   @postgres.VarChar(32)
  notes            String?  @postgres.VarChar(255)
  addressLine1     String   @postgres.VarChar(255)
  addressLine2     String?  @postgres.VarChar(255)
  city             String   @postgres.VarChar(255)
  zipCode          String?  @postgres.VarChar(20)
  latitude         Float
  longitude        Float
  formattedAddress String?  @postgres.VarChar(255)
  // Spec 0016: floor and the name on the doorbell. addressLine2 above is no longer written by
  // request-web; the migration moved its values into doorbell.
  floor            String?  @postgres.VarChar(20)
  doorbell         String?  @postgres.VarChar(60)
  // Moved only by an order using this customer, and never backwards. The retention job reads it.
  lastUsedAt       DateTime @default(now())
  // Row 99: when a rider last moved this customer's pin (spec 0016), shown to the restaurant; cleared
  // when the restaurant itself sets a different point.
  pinMovedByRiderAt DateTime? @postgres.Timestamptz(6)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([partnerId, phone])
}

model DeliveryQuote {
  id             String           @id @default(cuid())
  quote          Float?
  // The customer price: baseFee + distanceFee + the co-op fee part (spec 0001).
  quoteRangeFrom Int
  quoteRangeTo   Int
  feePercentage  Float            @default(0)
  // Spec 0047: PARTNER for a restaurant's own quote, SPLIT for a copy made for a new leg (price 0).
  source         EnumQuoteSource  @default(PARTNER)
  // The two parts the rider is paid, in whole cents, fixed when the quote is made.
  baseFee        Int
  distanceFee    Int
  currency       String           @postgres.VarChar(255)
  duration       Int
  distance       Float
  distanceUnit   EnumDistanceUnit @default(MILES)

  pickupPhoneNumber String? @postgres.VarChar(255)
  pickupName        String? @postgres.VarChar(255)

  dropoffPhoneNumber String? @postgres.VarChar(255)
  dropoffName        String? @postgres.VarChar(255)

  expiresAt DateTime?

  pickupReadyAt    DateTime?
  pickupDeadlineAt DateTime?

  dropoffReadyAt    DateTime?
  dropoffEta        DateTime?
  dropoffDeadlineAt DateTime?

  orderTotalValue Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pickupLocationId String
  pickupLocation   Location @relation(fields: [pickupLocationId], references: [id], onDelete: Cascade, name: "pickupDeliveryQuotes")

  dropoffLocationId String
  dropoffLocation   Location @relation(fields: [dropoffLocationId], references: [id], onDelete: Cascade, name: "dropoffDeliveryQuotes")

  partnerId String?
  partners  Partner? @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  deliveryId String?
  Delivery   Delivery?
}

model Delivery {
  id String @id @default(cuid())

  // Pickup data
  pickupName         String    @postgres.VarChar(255)
  pickupPhoneNumber  String    @postgres.VarChar(255)
  pickupBusinessName String    @postgres.VarChar(255)
  pickupNotes        String?   @postgres.VarChar(255)
  pickupVerification Json?     @postgres.Json
  pickupLocationId   String
  pickupReadyAt      DateTime? @postgres.Timestamptz(6)
  pickupDeadlineAt   DateTime? @postgres.Timestamptz(6)

  // Dropoff data
  dropoffName         String    @postgres.VarChar(255)
  dropoffPhoneNumber  String    @postgres.VarChar(255)
  dropoffBusinessName String?   @postgres.VarChar(255)
  dropoffNotes        String?   @postgres.VarChar(255)
  dropoffSellerNotes  String?   @postgres.VarChar(255)
  dropoffVerification Json?     @postgres.Json
  dropoffReadyAt      DateTime? @postgres.Timestamptz(6)
  dropoffEta          DateTime? @postgres.Timestamptz(6)
  dropoffDeadlineAt   DateTime? @postgres.Timestamptz(6)
  // Spec 0016: the floor and the name on the doorbell, the delivery's own copy. Never in the shared
  // Location row, which findOrCreate reuses across deliveries and restaurants.
  dropoffFloor        String?   @postgres.VarChar(20)
  dropoffDoorbell     String?   @postgres.VarChar(60)
  // Spec 0016: when the rider moved the drop off pin (at most once per delivery). The delivery's own
  // Location never moves; the move is a DROPOFF_POINT_CORRECTED event and reaches the saved customer.
  dropoffPointCorrectedAt DateTime? @postgres.Timestamptz(6)
  // Spec 0053 (cross check 1): the point the rider moved the pin to, written with the
  // DROPOFF_POINT_CORRECTED event, so courier notes find the real door. Null until a move.
  dropoffCorrectedLatitude  Float?
  dropoffCorrectedLongitude Float?
  // Spec 0020: when the rider accepted, and until when they may hand it back for free (both null
  // whenever no rider holds the delivery).
  acceptedAt              DateTime? @postgres.Timestamptz(6)
  handBackUntil           DateTime? @postgres.Timestamptz(6)
  // Spec 0023: the restaurant's current promise of when the food is ready (moves only later, by a
  // READY_DELAYED event), and when it tapped "Food ready" (set once, FOOD_READY). Null only on orders
  // made before this change. Never pickupReadyAt, which becomes the pickup moment at PICKED_UP.
  readyAt                 DateTime? @postgres.Timestamptz(6)
  foodReadyAt             DateTime? @postgres.Timestamptz(6)
  // Spec 0043: the box size the restaurant picked, and the share of a rider's 100 box units it
  // takes, copied from the co-op setting at creation so a later setting change never alters it.
  // boxSizeAssumed: no size was sent, so the co-op's default size was used (a BOX_SIZE_ASSUMED event).
  boxSize                 BoxSize
  boxUnits                Int
  boxSizeAssumed          Boolean   @default(false)

  deliverableAction        EnumDeliverableAction    @default(MEET_AT_DOOR)
  undeliverableAction      EnumUndeliverableAction?
  undeliverableReason      String?                  @postgres.VarChar(255)
  dropoffLocationId        String
  deliveryTypes            String[]                 @default(dbgenerated("(ARRAY[]::character varying[])::character varying(255)[]")) @postgres.VarChar(255)
  requiresDropoffSignature Boolean                  @default(false)
  requiresId               Boolean                  @default(false)

  // Order data
  orderReference  String?
  orderTotalValue Int?
  orderItems      Json?   @postgres.Json
  // Spec 0046: one leg of an order too big for one box ("leg 1 of 2"). Both null for a single delivery,
  // or both set with 1 <= legNumber <= legCount and 2 <= legCount <= 4 (a CHECK in the migration). The
  // legs of one order share partnerId and orderReference; the storefront sets them (Path A).
  legNumber       Int?
  legCount        Int?

  // Delivery data
  status             EnumDeliveryStatus @default(CREATED)
  customerNotes      String[]           @default(dbgenerated("(ARRAY[]::character varying[])::character varying(255)[]")) @postgres.VarChar(255)
  currencyCode       String             @postgres.VarChar(255)
  pickupTypes        String[]           @default(dbgenerated("(ARRAY[]::character varying[])::character varying(255)[]")) @postgres.VarChar(255)
  imageType          String?            @postgres.VarChar(255)
  imageName          String?            @postgres.VarChar(255)
  imageData          Bytes?
  idempotencyKey     String?
  externalStoreId    String?
  returnVerification Json?              @postgres.Json
  externalUserInfo   Json?
  externalId         String?
  courierId          String?
  partnerId          String?
  deliveryQuoteId    String             @unique

  totalCost         Int?
  fee               Int?
  feePercentage     Float?
  pay               Int?
  tips              Int    @default(0)
  totalCompensation Int?

  // Delivery matching data
  rejectedByCouriers String[]  @default([])
  matchedCourierId   String?
  // When the open offer to matchedCourierId went out, and when it ends on its own (spec 0002).
  // offerExpiresAt null = it never expires (expiry off, or an admin offer).
  offeredAt          DateTime?
  offerExpiresAt     DateTime?
  // Spec 0048 (AC-4): the two deliveries of a stacked offer share this id, so they are offered, accepted
  // and ended together. Set on both by the stack offer, null on every single offer; cleared when an open
  // stack ends or loses its partner, and kept after a group accept as the link admins see (cross check 7).
  offerGroupId       String?
  // Spec 0048 (cross check 6): the order of a stack's four stops, `[{ deliveryId, stop: "PICKUP" | "DROPOFF" }]`,
  // the same list on both deliveries. Written with the stack offer, kept through the accept, and cleared on
  // both (null) as soon as the two are no longer with one rider (an order ended, moved or was handed back):
  // the survivor then goes on alone. Advisory only: each delivery keeps its own status machine. Null on
  // every single offer.
  stopSequence       Json?
  // Spec 0048 (AC-6, row 81): what an add on offer adds to the rider's current job, in road metres and
  // seconds (the best stop order through both jobs, minus the current job alone). Written with the add on
  // offer, whose stopSequence names the current job; the phone shows "+2.1 km, +7 min". Kept afterwards as
  // the record of what was offered; read only while the delivery is an open add on (see isAddOnOffer).
  addOnExtraMetres   Int?
  addOnExtraSeconds  Int?

  // A cancellation (spec 0015). Set with the CANCELED status write, which is conditional, so
  // cancelledFromStatus is always the status the cancellation really came from; it decides the
  // rider's pay, the restaurant's charge and the food instructions.
  cancelledBy              EnumCancelledBy?
  cancelledFromStatus      EnumDeliveryStatus?
  cancelledAt              DateTime?
  // The cancelled job pay rule in force at the cancellation, written with it (decision 32.18): an
  // award the sweep writes later still pays under it, whatever a representative saved since.
  cancellationPayoutPolicy String?
  // What happened to food picked up before the cancellation: null until the rider records it.
  foodOutcome              EnumFoodOutcome?
  foodOutcomeAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pickupLocation  Location?     @relation(fields: [pickupLocationId], references: [id], onDelete: Cascade, name: "pickupDelivery")
  dropoffLocation Location?     @relation(fields: [dropoffLocationId], references: [id], onDelete: Cascade, name: "dropoffDelivery")
  courier         Courier?      @relation(fields: [courierId], references: [id])
  partner         Partner?      @relation(fields: [partnerId], references: [id])
  delivery        DeliveryQuote @relation(fields: [deliveryQuoteId], references: [id], onDelete: Cascade)

  payment              Payment[]
  // Spec 0033. The restaurant's first promise, never moved by a delay; when the rider arrived at the
  // restaurant (cleared when the delivery changes hands); when a rider left after waiting too long;
  // and when a wait became owed, which the sweep uses to finish a half written payment.
  promisedReadyAt      DateTime?
  arrivedAtPickupAt    DateTime?
  undispatchedAt       DateTime?
  waitPayOwedAt        DateTime?
  deliveryEvent        DeliveryEvent[]
  productReports       ProductReport[]
  locationNote         LocationNote[]
  courierCompensations CourierCompensation[]
  issues               DeliveryIssue[]
  removalRequests      DeliveryRemovalRequest[]
  // Spec 0047: the rider's requests to split this order at pickup.
  splitRequests        SplitRequest[]
  // Review requests about this delivery (spec 0038).
  reviewRequests       ReviewRequest[]
  // Complaints on this delivery (spec 0052).
  complaints           Complaint[]
  partnerCharges       PartnerCharge[]
  sosIncidents         SosIncident[]
  // Chat messages tagged with this delivery (spec 0034, chat).
  chatMessages         ChatMessage[]
  // The admin search's folded reference, customer and restaurant (spec 0025). Written only by the
  // database trigger `delivery_search_fold`; Prisma code never sets it, and no entity or DTO carries it.
  searchFold           String?

  @@unique([idempotencyKey, partnerId])
  // Spec 0046 (cross check 1): one leg number per order. Postgres counts NULLs as distinct, so a single
  // delivery (legNumber null) or one with no reference never collides; only two legs with the same number do.
  @@unique([partnerId, orderReference, legNumber])
  // A rider's cancelled jobs of the last 24 hours (spec 0015).
  @@index([courierId, cancelledAt])
  @@index([offerGroupId])
}

model DeliveryEvent {
  id                   String                  @id @default(cuid())
  transitionSuccessful Boolean
  type                 EnumDeliveryEventType
  actor                EnumEventActor
  eventSource          EnumDeliveryEventSource
  oldStatus            EnumDeliveryStatus?
  newStatus            EnumDeliveryStatus?
  message              String?

  delivery   Delivery @relation(fields: [deliveryId], references: [id])
  deliveryId String

  // The rider the event is about, on the types listed in saveDeliveryEvent
  // (delivery-event.service.ts): offers, removals, pay events, since spec 0038 the review
  // events, and since spec 0040 ACCEPTED (the accepting rider, which time worked reads). Null on
  // every other event (spec 0002), and on ACCEPTED events from before spec 0040 except those
  // still in progress when its migration ran.
  courier   Courier? @relation(fields: [courierId], references: [id])
  courierId String?

  // When the step happened: the rider's tap for a courier job step sent late from a phone with
  // no signal, the moment the server handled it for every other event (spec 0009). Earnings
  // count a job's money on the day of its ACCEPTED occurredAt, in Europe/Athens (spec 0042).
  occurredAt DateTime @default(now())
  // When the server received it.
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([newStatus, occurredAt])
  // Time worked (spec 0040) asks for a rider's ACCEPTED events, then for every event of those
  // deliveries, and the rider's home counter repeats that every few minutes. Without these two
  // indexes each of those reads walks the whole table (decision 36.47).
  @@index([courierId, type])
  @@index([deliveryId])
  // Spec 0044: why this offer went to this rider (only on OFFERED events). Not a column here.
  offerReason OfferReason?
}

// Spec 0044 (rows 12 and 13): why an offer went to its rider, one row per OFFERED event, from any
// matcher or an admin. Numbers, never prose, so it can be read back by number (row 14's why this offer,
// the admin audit, a replay). `candidates` holds every scored rider's values: admin only, never sent to
// a rider (it holds other riders' earnings).
model OfferReason {
  id              String        @id @default(cuid())
  deliveryEventId String        @unique
  deliveryEvent   DeliveryEvent @relation(fields: [deliveryEventId], references: [id], onDelete: Cascade)
  deliveryId      String
  courierId       String
  // FAIRNESS, NEAREST_COURIER, COURIER_SENIORITY, STATIC, or ADMIN for a hand offer or a reassign.
  strategy        String
  // The weights in force, only those that applied: { roadTime, earnings, waiting, shift? }.
  weights         Json?
  // The chosen rider's raw values and their scaled values: shape by strategy (spec 0044, cross check 10).
  values          Json
  score           Float?
  // How many riders were scored, and how many passed every filter (the shortlist may leave some out).
  candidateCount  Int           @default(0)
  ridersInRange   Int           @default(0)
  candidates      Json?
  // SINGLE today; spec 0048 adds STACK and ADD_ON.
  kind            String        @default("SINGLE")
  createdAt       DateTime      @default(now())

  // Spec 0045 reads a rider's own reasons, newest first.
  @@index([courierId, createdAt])
  @@index([deliveryId])
}

model LocationNote {
  id        String   @id @default(cuid())
  note      String?  @postgres.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  actor EnumLocationNoteActor

  locationId String?
  locations  Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  deliveryId String?
  delivery   Delivery? @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  courierId     String?
  couriers      Courier?               @relation(fields: [courierId], references: [id], onDelete: Cascade)
  noteReactions LocationNoteReaction[]

  // Spec 0053: the point the note is about (the drop off point as the rider found it, or the
  // restaurant's), and when a rider last confirmed it (creation, then each upvote by someone else).
  // A note not confirmed for addressNoteRetentionDays is deleted by the nightly job.
  latitude        Float
  longitude       Float
  lastConfirmedAt DateTime           @default(now())
  flags           LocationNoteFlag[]

  @@index([lastConfirmedAt])
  @@index([latitude, longitude])
}

// Spec 0053 (AC-7): a rider's flag on a note, once per rider. Dismissing the flags deletes these rows.
model LocationNoteFlag {
  id             String       @id @default(cuid())
  locationNoteId String
  locationNote   LocationNote @relation(fields: [locationNoteId], references: [id], onDelete: Cascade)
  courierId      String
  courier        Courier      @relation(fields: [courierId], references: [id], onDelete: Cascade)
  reason         String?      @postgres.VarChar(200)
  createdAt      DateTime     @default(now())

  @@unique([locationNoteId, courierId])
}

// Spec 0053 (AC-7): an admin deleted a note. Who, which note and when; the note's text is not kept,
// and both ids are plain strings, so the row outlives the note and the admin account.
model AddressNoteDeletion {
  id             String   @id @default(cuid())
  adminUserId    String
  locationNoteId String
  createdAt      DateTime @default(now())
}

model LocationNoteReaction {
  id        String                       @id @default(cuid())
  reaction  EnumLocationNoteReactionType
  createdAt DateTime                     @default(now())
  updatedAt DateTime                     @updatedAt

  locationNoteId String
  locationNote   LocationNote @relation(fields: [locationNoteId], references: [id], onDelete: Cascade)

  courierId String
  couriers  Courier @relation(fields: [courierId], references: [id], onDelete: Cascade)
}

model CourierSetting {
  id                          String                    @id @default(cuid())
  deliveryPolygon             Unsupported("geometry")?
  vehicleType                 EnumSettingVehicleType?
  preferredAreas              String[]                  @default(dbgenerated("(ARRAY[]::character varying[])::character varying(255)[]")) @postgres.VarChar(255)
  shiftAvailability           Json?                     @default("{\"sunday\":[],\"monday\":[],\"tuesday\":[],\"wednesday\":[],\"thursday\":[],\"friday\":[],\"saturday\":[]}") @postgres.Json
  deliveryPreferences         String[]                  @default(dbgenerated("(ARRAY[]::character varying[])::character varying(255)[]")) @postgres.VarChar(255)
  foodPreferences             String[]                  @default(dbgenerated("(ARRAY[]::character varying[])::character varying(255)[]")) @postgres.VarChar(255)
  earningGoals                Json?                     @postgres.Json
  deliverySpeed               EnumSettingDeliverySpeed? @default(REGULAR)
  restaurantTypes             String[]                  @default(dbgenerated("(ARRAY[]::character varying[])::character varying(255)[]")) @postgres.VarChar(255)
  cuisineTypes                String[]                  @default(dbgenerated("(ARRAY[]::character varying[])::character varying(255)[]")) @postgres.VarChar(255)
  preferredRestaurantPartners String[]                  @default(dbgenerated("(ARRAY[]::character varying[])::character varying(255)[]")) @postgres.VarChar(255)
  dietaryRestrictions         String[]                  @default(dbgenerated("(ARRAY[]::character varying[])::character varying(255)[]")) @postgres.VarChar(255)
  payRate                     Json?                     @postgres.Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courierId String?  @unique
  couriers  Courier? @relation(fields: [courierId], references: [id], onDelete: Cascade)
}

model Payout {
