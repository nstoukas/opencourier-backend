enum EnumDeliverableAction {
  MEET_AT_DOOR
  LEAVE_AT_DOOR
}

// Why dispatch was stopped (spec 0014).
enum EnumDispatchStopReason {
  HEAT
  STORM
  OTHER
}

// A stop of all dispatch, now or scheduled (spec 0014). The rows are the record members read and the
// state the platform obeys: a stop is on while it has started, is not cancelled or ended, and its
// end (if any) has not passed. Rows are never deleted.
model DispatchStop {
  id                String                 @id @default(cuid())
  reason            EnumDispatchStopReason
  startsAt          DateTime
  // Null: until an admin restarts dispatch.
  endsAt            DateTime?
  createdByUserId   String
  createdAt         DateTime               @default(now())
  // When the start work ran (offers ended, accepted deliveries returned to waiting).
  startedAt         DateTime?
  // A restart before the planned end.
  endedAt           DateTime?
  endedByUserId     String?
  // Cancelled before it started.
  cancelledAt       DateTime?
  cancelledByUserId String?
  // When the end work ran (every waiting delivery matched again).
  endWorkDoneAt     DateTime?

  @@index([startsAt])
}

enum EnumSosOutcome {
  RIDER_SAFE
  HELP_ARRIVED
  FALSE_ALARM
  OTHER
}

// A rider's SOS (spec 0022). Active while closedAt, safeAt and falseAlarmAt are all null: only then
// does the phone share its position (SosLocationPoint) and the rider count as busy. Awaiting close
// once the rider said safe or false alarm; closed once an admin closed it. Rows are never deleted,
// only their points (binding values 1 and 5).
model SosIncident {
  id              String          @id @default(cuid())
  // Restrict: deleting a rider never deletes the record of their SOS.
  courierId       String
  courier         Courier         @relation(fields: [courierId], references: [id], onDelete: Restrict)
  // The phone's own id for this SOS, so a start retried after no signal never makes a second one.
  clientId        String          @postgres.VarChar(64)
  // The job the rider held at the hold, if any.
  deliveryId      String?
  delivery        Delivery?       @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  // When the rider completed the hold (tapAgeMs), not when it arrived (createdAt).
  startedAt       DateTime        @postgres.Timestamptz(6)
  createdAt       DateTime        @default(now())
  safeAt          DateTime?       @postgres.Timestamptz(6)
  falseAlarmAt    DateTime?       @postgres.Timestamptz(6)
  closedAt        DateTime?       @postgres.Timestamptz(6)
  closedByUserId  String?
  closedBy        User?           @relation(fields: [closedByUserId], references: [id], onDelete: SetNull)
  outcome         EnumSosOutcome?
  note            String?         @postgres.VarChar(500)
  // When the retention job deleted this incident's points.
  pointsDeletedAt DateTime?       @postgres.Timestamptz(6)

  points SosLocationPoint[]

  @@unique([courierId, clientId])
  @@index([courierId, closedAt])
}

// One position the phone sent during an active SOS (spec 0022). Read only by the SOS module, for
// the admin incident page; deleted by the daily retention job after sosLocationRetentionDays.
model SosLocationPoint {
  id             String      @id @default(cuid())
  incidentId     String
  incident       SosIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  latitude       Float
  longitude      Float
  accuracyMetres Float?
  // Server receipt time minus the point's age on the phone, never before the incident's start.
  recordedAt     DateTime    @postgres.Timestamptz(6)
  createdAt      DateTime    @default(now())

  @@index([incidentId, recordedAt])
}

// Spec 0026 (row 77): a weekly shift slot the co-op plans cover with, in Athens wall time. Riders book
// it from row 78; with the Shifts setting off it changes nothing for anyone.
model ShiftSlot {
  id          String            @id @default(cuid())
  // ISO 8601: 1 Monday to 7 Sunday.
  weekday     Int
  // Minutes after midnight; the slot ends after it starts, on the same day (never across midnight).
  startMinute Int
  endMinute   Int
  // The most riders the slot takes, 1 to 50.
  riderCap    Int
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  // Removed by an admin: no longer listed, but kept for its record and row 78's bookings.
  removedAt   DateTime?
  changes     ShiftSlotChange[]
  bookings    ShiftBooking[]

  @@index([removedAt, weekday, startMinute])
}

enum EnumShiftSlotChangeAction {
  CREATED
  UPDATED
  REMOVED
}

// Spec 0026 (AC-3): every slot change, written in the slot write's transaction, so members can follow
// who changed the cover and when (binding value 1's spirit for the co-op's own records).
model ShiftSlotChange {
  id              String                    @id @default(cuid())
  shiftSlotId     String
  shiftSlot       ShiftSlot                 @relation(fields: [shiftSlotId], references: [id])
  action          EnumShiftSlotChangeAction
  // The admin's user id, as DispatchStop.createdByUserId.
  changedByUserId String
  // The four slot fields before (null on create) and after (null on remove).
  before          Json?                     @postgres.Json
  after           Json?                     @postgres.Json
  createdAt       DateTime                  @default(now())

  @@index([shiftSlotId, createdAt])
}

enum EnumShiftBookingStatus {
  BOOKED
  DROPPED
  SWAPPED_AWAY
}

enum EnumShiftBookingEventType {
  BOOKED
  DROPPED
  SWAP_OFFERED
  SWAP_WITHDRAWN
  SWAP_TAKEN
  // Spec 0049 (row 79): still Offline past the break limit during this booked shift. A record both the
  // rider and an admin see; nothing counts, ranks or reads it for matching or pay (value 5).
  WENT_OFFLINE_MID_SHIFT
}

// Spec 0027 (row 78): a rider's booking of one occurrence of a weekly slot. Its date, times and the cap
// in force are a snapshot taken when booked (row 77's contract), so a later slot edit or removal never
// changes a booked shift.
model ShiftBooking {
  id            String                 @id @default(cuid())
  shiftSlotId   String
  shiftSlot     ShiftSlot              @relation(fields: [shiftSlotId], references: [id])
  courierId     String
  courier       Courier                @relation(fields: [courierId], references: [id])
  // The occurrence's Athens date, YYYY-MM-DD.
  date          String
  startsAt      DateTime
  endsAt        DateTime
  // Record only (value 1): the cap check uses the slot's current cap.
  capAtBooking  Int
  status        EnumShiftBookingStatus @default(BOOKED)
  // Set while the rider offers it as a swap any other rider may take.
  swapOfferedAt DateTime?
  createdAt     DateTime               @default(now())
  // When it was dropped or swapped away.
  endedAt       DateTime?
  events        ShiftBookingEvent[]

  @@index([shiftSlotId, date, status])
  @@index([courierId, status, startsAt])
}

// Spec 0027 (AC-7): every booking change, written in the change's transaction. No rider route reads it.
model ShiftBookingEvent {
  id             String                    @id @default(cuid())
  shiftBookingId String
  shiftBooking   ShiftBooking              @relation(fields: [shiftBookingId], references: [id])
  type           EnumShiftBookingEventType
  // Who acted.
  courierId      String
  // The other rider in a swap: the taker on the giver's SWAP_TAKEN, the giver on the taker's BOOKED.
  otherCourierId String?
  createdAt      DateTime                  @default(now())

  // Spec 0051: the admin whose action made this event (a booking dropped at a deactivation).
  adminUserId           String?
  // Spec 0049, WENT_OFFLINE_MID_SHIFT only: the status change it came from (one event per change), its
  // cause and time, and an admin's follow up in person.
  courierStatusChangeId String?                       @unique
  cause                 EnumCourierStatusChangeCause?
  offlineAt             DateTime?
  followedUpAt          DateTime?
  followedUpByUserId    String?
  followedUpBy          User?                         @relation("ShiftEventFollowedUpBy", fields: [followedUpByUserId], references: [id], onDelete: SetNull)

  @@index([shiftBookingId, createdAt])
  @@index([type, followedUpAt])
}

// Spec 0034, chat. Who wrote a chat message. SYSTEM is a line the server writes (a rider report).
enum EnumChatSenderKind {
  DISPATCH
  COURIER
  PARTNER
  SYSTEM
}

// Spec 0034, chat. One continuing conversation between dispatch and one rider or one restaurant.
// Exactly one of courierId and partnerId is set (a raw SQL CHECK in the migration; Prisma can't say it).
model ChatThread {
  id        String   @id @default(cuid())
  courierId String?  @unique
  courier   Courier? @relation(fields: [courierId], references: [id], onDelete: Cascade)
  partnerId String?  @unique
  partner   Partner? @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  // The newest message's time; null when retention removed every message (AC-18), which hides the thread.
  lastMessageAt      DateTime?
  // Shared by every admin: the thread is read up to here. Only ever moves forward (AC-7).
  // Nothing records when a rider or restaurant read anything (AC-6).
  dispatchLastReadAt DateTime?
  createdAt          DateTime  @default(now())

  messages ChatMessage[]

  @@index([lastMessageAt])
}

// Spec 0034, chat. One line in a thread. Never edited or deleted, except by the retention job (AC-4, AC-18).
model ChatMessage {
  id           String             @id @default(cuid())
  threadId     String
  thread       ChatThread         @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderKind   EnumChatSenderKind
  // Empty for SYSTEM lines, and when the writer's account is deleted.
  senderUserId String?
  senderUser   User?              @relation(fields: [senderUserId], references: [id], onDelete: SetNull)
  body         String             @postgres.VarChar(1000)
  // The delivery this message is about, if any.
  deliveryId   String?
  delivery     Delivery?          @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  // The sender's own id for this message, so a retry after bad signal never makes a second one (AC-19).
  clientMessageId String?
  createdAt       DateTime @default(now())

  @@unique([threadId, clientMessageId])
  @@index([threadId, createdAt])
  @@index([createdAt])
}

enum EnumReviewTopic {
  OFFER
  PAY
  OTHER
}

enum EnumReviewRequestStatus {
  OPEN
  ANSWERED
  WITHDRAWN
}

enum EnumReviewOutcome {
  // The decision was right.
  STANDS
  // The decision was wrong and was put right.
  CHANGED
}

// Spec 0038: a rider asks a person to review a decision the app took about their work. Only an
// admin's answer or the rider's own withdrawal moves it out of OPEN; nothing answers it on its own.
// The note and the answer are personal data: never in a log line, an event message or a push.
model ReviewRequest {
  id          String                  @id @default(cuid())
  topic       EnumReviewTopic
  // The rider's words.
  note        String                  @postgres.VarChar(1000)
  status      EnumReviewRequestStatus @default(OPEN)
  createdAt   DateTime                @default(now())
  // Fixed when sent (send time + reviewAnswerDays x 24 h); never moved afterwards.
  dueAt       DateTime
  // `<courierId>:<deliveryId>` while OPEN on a delivery, null otherwise: one open request per
  // rider per delivery (the openFor pattern of spec 0035).
  openFor     String?                 @unique
  answeredAt  DateTime?
  outcome     EnumReviewOutcome?
  answer      String?                 @postgres.VarChar(2000)
  withdrawnAt DateTime?

  courierId        String
  courier          Courier   @relation(fields: [courierId], references: [id])
  // Null for a general request.
  deliveryId       String?
  delivery         Delivery? @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  answeredByUserId String?
  answeredBy       User?     @relation(fields: [answeredByUserId], references: [id], onDelete: SetNull)

  @@index([status, dueAt])
  @@index([courierId, createdAt])
}

// Spec 0052 (row 83): complaints both ways, with no ratings. Who filed it.
enum EnumComplaintFiledBy {
  RIDER
  RESTAURANT
  ADMIN
}

// Who the complaint is about. A rider files about a restaurant or a customer; a restaurant or an
// admin files about a rider. Never a rider about another rider.
enum EnumComplaintAbout {
  RESTAURANT
  CUSTOMER
  RIDER
}

// OPEN: waiting for an admin. AWAITING_REPLY: about a rider, waiting for their reply; no admin can
// decide it yet (AC-5). DECIDED: an admin wrote the outcome. WITHDRAWN: an admin closed it with no
// finding against anyone (cross check 6).
enum EnumComplaintStatus {
  OPEN
  AWAITING_REPLY
  DECIDED
  WITHDRAWN
}

// One list for every `about`; which categories fit which `about` is checked in
// src/domains/complaint/complaint-rules.ts (AC-1). The apps word them from translation keys.
enum EnumComplaintCategory {
  LONG_WAIT
  FOOD_NOT_READY
  UNSAFE_PACKAGING
  RUDE_STAFF
  ABUSE_OR_THREAT
  UNSAFE_ADDRESS
  NOT_ANSWERING
  LATE
  RUDE
  FOOD_DAMAGED
  OTHER
}

// Spec 0052: one complaint about a restaurant, a customer or a rider, on one delivery. Every
// filing, reply, decision and withdrawal is stored here with who and when (AC-10); no DeliveryEvent
// is written, since a complaint changes no status, pay or assignment. Nothing that matches, pays or
// scores riders reads this table, and nothing counts it per rider (AC-8, binding value 5).
model Complaint {
  id        String                @id @default(cuid())
  filedBy   EnumComplaintFiledBy
  about     EnumComplaintAbout
  category  EnumComplaintCategory
  // The filer's words. Never logged, never put in a push.
  text      String                @postgres.VarChar(1000)
  status    EnumComplaintStatus
  createdAt DateTime              @default(now())
  // `<filer kind>:<filer id>:<deliveryId>:<about>` while the complaint is open (OPEN or
  // AWAITING_REPLY), null once closed: one open complaint per filer per delivery (cross check 6).
  // Null for an admin's filing, which is made on behalf of whoever called in.
  openFor   String?               @unique
  // Slice 2: the key of the one photo a rider may attach, in the private MinIO `complaints` bucket
  // (random, never a URL). Read only through the rider's and the admin's photo routes. A hand written
  // CHECK keeps it on a rider's filing only.
  photoKey  String?               @postgres.VarChar(100)

  deliveryId     String
  delivery       Delivery @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  // Exactly one filer id is set, matching filedBy.
  filerCourierId String?
  filerCourier   Courier? @relation(name: "complaintFiledByCourier", fields: [filerCourierId], references: [id], onDelete: Restrict)
  filerPartnerId String?
  filerPartner   Partner? @relation(fields: [filerPartnerId], references: [id], onDelete: Restrict)
  filerAdminId   String?
  filerAdmin     User?    @relation(name: "complaintFiledByAdmin", fields: [filerAdminId], references: [id], onDelete: SetNull)
  // The rider a complaint about a rider is about: the delivery's rider at filing, or one an admin
  // picked from the riders who accepted it (cross check 3). Null for any other `about`.
  aboutCourierId String?
  aboutCourier   Courier? @relation(name: "complaintAboutCourier", fields: [aboutCourierId], references: [id], onDelete: Restrict)

  // The rider's reply, stored once (AC-5). Entered by an admin only for a deactivated rider, from a
  // phone call; then replyEnteredByUserId names that admin (cross check 2).
  riderReply           String?   @postgres.VarChar(1000)
  repliedAt            DateTime?
  replyEnteredByUserId String?
  replyEnteredBy       User?     @relation(name: "complaintReplyEnteredBy", fields: [replyEnteredByUserId], references: [id], onDelete: SetNull)

  outcome         String?   @postgres.VarChar(1000)
  decidedAt       DateTime?
  decidedByUserId String?
  decidedBy       User?     @relation(name: "complaintDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  withdrawnReason   String?   @postgres.VarChar(1000)
  withdrawnAt       DateTime?
  withdrawnByUserId String?
  withdrawnBy       User?     @relation(name: "complaintWithdrawnBy", fields: [withdrawnByUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([about, createdAt])
  @@index([deliveryId])
  @@index([filerCourierId, createdAt])
  @@index([filerPartnerId, createdAt])
  @@index([aboutCourierId, createdAt])
}

// Spec 0038 (AC-12): one row per setting whose effective value a save changed, written in the
// value's transaction. Riders read the rider facing keys, credited to "a representative".
model SettingChange {
  id              String   @id @default(cuid())
  // A ConfigKey value, `removalReason` or `shiftSlot`.
  key             String   @postgres.VarChar(100)
  // The removal reason's or the shift slot's id; null for a Config key.
  subject         String?  @postgres.VarChar(100)
  // Null on a create.
  oldValue        Json?
  // Null on a removal.
  newValue        Json?
  createdAt       DateTime @default(now())
  changedByUserId String?
  changedBy       User?    @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([key, createdAt])
}

// One change of a rider's status (spec 0040). Append only: never updated or deleted. Written
// only by CourierRepository.changeStatus, in the same transaction as the status itself, so a
// rider's last row always holds their current status. A rider with no row has always been
// Offline. Time worked is worked out from these rows when read, never stored.
model CourierStatusChange {
  id          String                       @id @default(cuid())
  courierId   String
  courier     Courier                      @relation(fields: [courierId], references: [id])
  fromStatus  EnumCourierStatus
  toStatus    EnumCourierStatus
  cause       EnumCourierStatusChangeCause
  // The admin on an ADMIN row, and on a CUT_OFF row an admin's password change caused.
  adminUserId String?
  adminUser   User?                        @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  // clock_timestamp() taken after the courier row is locked, so a rider's rows sort in the order
  // their changes happened.
  createdAt   DateTime                     @default(now())

  @@index([courierId, createdAt])
  @@index([createdAt])
}

// Spec 0051 (row 108): what an account change was.
enum EnumCourierAccountChangeKind {
  DEACTIVATED
  REACTIVATED
  FIELD_EDITED
  PASSWORD_CHANGED
  // Spec 0050 (cross check 14): an admin downloaded this rider's monthly statement.
  STATEMENT_DOWNLOADED
}

// Spec 0051 (AC-5): one account action on a rider: a deactivation, a reactivation, one edited field, or a
// password change. The rider reads their own (the actor shown as "the co-op"); admins read them with the
// admin's name. A password is never stored, only that it changed. Never counted per rider (value 5).
model CourierAccountChange {
  id           String                       @id @default(cuid())
  courierId    String
  courier      Courier                      @relation(fields: [courierId], references: [id])
  // The admin who acted; null when the rider did (actorIsRider) or the admin was later deleted.
  actorUserId  String?
  actorIsRider Boolean                      @default(false)
  kind         EnumCourierAccountChangeKind
  // FIELD_EDITED only: which field, and its value before and after.
  field        String?                      @postgres.VarChar(60)
  oldValue     String?                      @postgres.VarChar(300)
  newValue     String?                      @postgres.VarChar(300)
  reason       String?                      @postgres.VarChar(300)
  createdAt    DateTime                     @default(now())

  @@index([courierId, createdAt])
}

// Spec 0050 (row 76, AC-9, cross check 14): an admin downloaded a rider's monthly statement. Kept with no
// cascade: the record stays when either side is deleted.
model StatementDownload {
  id          String   @id @default(cuid())
  adminUserId String
  admin       User     @relation(fields: [adminUserId], references: [id], onDelete: Restrict)
  courierId   String
  courier     Courier  @relation(fields: [courierId], references: [id], onDelete: Restrict)
  // YYYY-MM.
  month       String   @postgres.VarChar(7)
  // pdf or csv.
  format      String   @postgres.VarChar(3)
  createdAt   DateTime @default(now())

  @@index([courierId, createdAt])
}
