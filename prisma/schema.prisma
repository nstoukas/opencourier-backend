  DUPLICATE
  FRAUDULENT
  REQUESTED_BY_CUSTOMER
  EXPIRED_UNCAPTURED_CHARGE
}

enum EnumRefundStatus {
  PENDING
  REQUIRES_ACTION
  SUCCEEDED
  FAILED
  CANCELED
